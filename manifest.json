{
  "manifest_version": 3,
  "name": "Chrome-Simple-Memo",
  "version": "1.0",
  "description": "シンプルなマークダウンメモ帳",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Simple Memo"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["memo.html"],
      "matches": ["<all_urls>"]
    }
  ]
}