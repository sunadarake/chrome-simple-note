{
   "attribution" : {
      "commit" : "",
      "pr" : ""
   },
   "hooks" : {
      "PreToolUse" : [
         {
            "hooks" : [
               {
                  "command" : "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-rm.sh\"",
                  "type" : "command"
               }
            ],
            "matcher" : "Bash"
         },
         {
            "hooks" : [
               {
                  "command" : "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret.sh\"",
                  "type" : "command"
               }
            ],
            "matcher" : "Bash"
         }
      ]
   },
   "includeCoAuthoredBy" : false,
   "permissions" : {
      "allow" : [
         "Bash(rg:*)",
         "Bash(grep:*)",
         "Bash(egrep:*)",
         "Bash(fgrep:*)",
         "Bash(mkdir:*)",
         "Bash(cp:*)",
         "Bash(mv:*)",
         "Bash(touch:*)",
         "Bash(chmod:*)",
         "Bash(chown:*)",
         "Bash(find:*)",
         "Bash(cat:*)",
         "Bash(head:*)",
         "Bash(tail:*)",
         "Bash(less:*)",
         "Bash(more:*)",
         "Bash(wc:*)",
         "Bash(sort:*)",
         "Bash(uniq:*)",
         "Bash(cut:*)",
         "Bash(awk:*)",
         "Bash(sed:*)",
         "Bash(tee:*)",
         "Bash(ls:*)",
         "Bash(stat:*)",
         "Bash(file:*)",
         "Bash(diff:*)",
         "Bash(du:*)",
         "Bash(df:*)",
         "Bash(which:*)",
         "Bash(whereis:*)",
         "Bash(pwd:*)",
         "Bash(echo:*)",
         "Bash(curl:*)",
         "Bash(base64:*)",
         "Bash(git:*)",
         "List(*)",
         "Edit(*)",
         "Write(*)",
         "mcp__voicevox__speak"
      ],
      "deny" : [
         "Bash(rm -rf:*)",
         "Bash(git push --force:*)",
         "Read(~/.ssh/**)",
         "Read(./.env)",
         "Bash(rm -rf /)",
         "Bash(rm -rf ~)",
         "Bash(rm -rf $HOME)",
         "Bash(rm -fr /)",
         "Bash(rm -fr ~)",
         "Bash(rm -fr $HOME)"
      ]
   }
}
